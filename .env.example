# Copy this file to .env and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# Without these, Orbit runs in "offline test mode" (live games only connect tabs in one browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database URL (Build -> Realtime Database), e.g. https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
